<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- 発行先の実行環境（自己完結版・フレームワーク依存版とも win-x64） -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- 版の文字列にコミットハッシュを付けない（1.0.3 の形にする） -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <Version>1.0.3</Version>
    <Title>Large Folder Finder</Title>
    <Copyright>Copyright (C) 2026 Ryoma Henzan / Cat &amp; Chocolate Laboratory</Copyright>
    <AssemblyName>LargeFolderFinder</AssemblyName>
    <RootNamespace>LargeFolderFinder</RootNamespace>
    <!-- テスト・スクリプト・発行物のフォルダはアプリのビルドに含めない -->
    <DefaultItemExcludes>$(DefaultItemExcludes);TestPerf\**;Tools\**;Tests\**;build\**;artifacts\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MessagePack" Version="3.1.9" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\License\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\Languages\**\*.yaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\Readme\**\*.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Config.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
